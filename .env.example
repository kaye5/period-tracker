# Copy this file to .env.local (gitignored — see .gitignore's "env files" section) and
# fill in real values before running the app, `pnpm db:migrate`, or `pnpm db:seed`.
# Never commit .env.local.
#
# This build connects to a MySQL-wire-compatible database (MySQL or TiDB, via Drizzle +
# mysql2 — DEC-011). See docs/PRIVACY.md for what that means for your data.
#
# Only one variable is required, plus one optional:

# mysql://user:password@host:3306/period_tracker
# For the local Docker MySQL started by `pnpm db:up` (see docker-compose.yml), this is:
#   DATABASE_URL="mysql://app:app_password@127.0.0.1:3306/period_tracker"
DATABASE_URL="mysql://user:password@host:3306/period_tracker"

# Set to enable TLS on the mysql2 connection. Required for TiDB Cloud (whose default
# port is usually 4000, not 3306) and for most hosted MySQL providers. Leave unset for
# the local Docker MySQL.
# DATABASE_SSL=true
